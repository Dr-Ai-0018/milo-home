  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
